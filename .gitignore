# This .gitignore is tailored for this Unity project (see CLAUDE.md for folder layout notes)

# Unity-generated folders - not source of truth, safe to regenerate
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Build output / packaged builds
/build/
*.apk
*.aab
*.unitypackage
*.app

# Project-specific generated/debug artifacts (see CLAUDE.md)
/My project_BurstDebugInformation_DoNotShip/
/AAGame_BackUpThisFolder_ButDontShipItWithYourGame/
/GeneratedAssets/
/.utmp/

# Autogenerated VS/Rider/IDE solution and project files (regenerated by Unity)
.vs/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash/sysinfo dumps
sysinfo.txt
crashlytics-build.properties

# OS cruft
.DS_Store
